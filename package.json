{
  "name": "anime-quarter-schedule",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -H 127.0.0.1 --webpack",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "data:init": "node --experimental-strip-types scripts/init-data.ts",
    "data:update": "node --experimental-strip-types scripts/update-season.ts",
    "data:reconcile": "node --experimental-strip-types scripts/reconcile-current-cache.ts",
    "data:sync-bangumi": "node --experimental-strip-types scripts/sync-bangumi-details.ts",
    "data:match-bangumi": "node --experimental-strip-types scripts/match-missing-bangumi.ts",
    "data:validate": "node --experimental-strip-types scripts/validate-cache.ts",
    "data:audit": "node --experimental-strip-types scripts/audit-cache.ts",
    "api:smoke": "node --experimental-strip-types scripts/api-smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run data:validate && npm run api:smoke",
    "vercel:build": "npm run check && next build",
    "data:refresh-bangumi": "node --experimental-strip-types scripts/refresh-bangumi-snapshots.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
