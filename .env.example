# App
NEXT_PUBLIC_APP_NAME="日本季度新番更新时间表"
NEXT_PUBLIC_DEFAULT_YEAR=2026
NEXT_PUBLIC_DEFAULT_SEASON=7

# Local server
PORT=3000
NODE_ENV=development

# Storage
# Current implementation supports local-json.
STORAGE_DRIVER=local-json
DATA_DIR=./data

# Update behavior
UPDATE_LOCK_TTL_SECONDS=900

# Bangumi
# Public subject/search/detail reads can start without a token.
# Keep User-Agent explicit and identifiable. Do not expose tokens with NEXT_PUBLIC_* names.
BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_USER_AGENT="anime-quarter-schedule-local/0.1.1 (contact: local-dev)"
BANGUMI_ACCESS_TOKEN=
BANGUMI_RATE_LIMIT_PER_MINUTE=30
BANGUMI_SUBJECT_LIST_POWERSHELL_FALLBACK=true
BANGUMI_POWERSHELL_FALLBACK=false

# Bahamut
# Optional reference source. When enabled, local or fetched Bahamut timetable times can fill updateTime.
BAHAMUT_ENABLED=true
BAHAMUT_REFERENCES_FILE=./data/bahamut-references.json
BAHAMUT_TIMETABLE_URLS=
BAHAMUT_TIMETABLE_FILES=./data/bahamut-timetable.html
BAHAMUT_USER_AGENT="anime-quarter-schedule-local/0.1.1 (contact: local-dev)"
BAHAMUT_TIMEOUT_MS=15000
BAHAMUT_RATE_LIMIT_PER_MINUTE=3

# YourAnimes
# Lower-priority fallback for Japan broadcast premiere/update times after Bangumi and Bahamut.
YOURANIMES_ENABLED=true
YOURANIMES_TIMETABLE_URLS=
YOURANIMES_TIMETABLE_FILES=
YOURANIMES_USER_AGENT="anime-quarter-schedule-local/0.1.1 (contact: local-dev)"
YOURANIMES_TIMEOUT_MS=15000

# Last-resort verified Beijing-time overrides, applied after Bangumi/Bahamut/YourAnimes.
MANUAL_BROADCAST_OVERRIDES_FILE=./data/manual-broadcast-overrides.json

# Manual update and cron protection
UPDATE_API_TOKEN=
ENABLE_VERCEL_UPDATE=false

# Vercel deployment placeholders
VERCEL_ENV=
VERCEL_REGION=
